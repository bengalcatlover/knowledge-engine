# === LLM API Settings ===
# このファイルをコピーして .env を作成し、各キーを設定してください。
# cp .env.example .env

# メインのバッチ処理用
LLM_API_KEY=
LLM_BATCH_MODEL=gpt-4.1-nano-2025-04-14
LLM_BATCH_ENDPOINT=https://api.openai.com/v1/chat/completions

# セカンダリLLM（knowledge_amplifierのクロスチェック用）
LLM_SECONDARY_KEY=
LLM_SECONDARY_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-lite:generateContent

# Embedding API（search_engine用）
EMBED_API_KEY=
EMBED_MODEL=gemini-embedding-001
EMBED_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# ワーカーモデル（形式上、実際はcheap_llmに委譲）
LLM_WORKER_MODEL=worker-default
